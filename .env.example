# GhostWriter Environment Configuration

# Port for the Flask backend or web server (Render automatically sets $PORT)
PORT=5000

# Gemma 2 Model identifier
GEMMA_MODEL="google/gemma-2-9b-it"

# (Optional) Hugging Face User Access Token for direct Hugging Face Inference API calls:
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=""

# (Optional) Groq API Key for ultra-fast Gemma 2 9B inference:
# Get one at https://console.groq.com/keys
GROQ_API_KEY=""

# (Optional) Google API Key:
GEMINI_API_KEY=""

# Host URL
APP_URL="http://localhost:3000"
